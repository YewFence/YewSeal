#!/usr/bin/env bash
set -euo pipefail

binary_name="${BINARY_NAME:-yews}"
main_path="${MAIN_PATH:-./cmd/yews/}"
build_dir="${BUILD_DIR:-./build}"
version="$(git describe --tags --always --dirty 2>/dev/null || echo "dev")"
ldflags="-s -w -X main.Version=${version}"
targets=(
  "linux/amd64"
  "linux/arm64"
  "windows/amd64"
  "windows/arm64"
  "darwin/amd64"
  "darwin/arm64"
)

usage() {
  cat <<EOF
Usage:
  mise run build
  mise run build -- --target linux/amd64
  mise run build -- --all
  mise run build -- --release

Targets can use linux/amd64 or linux-amd64.
EOF
}

target_ext() {
  if [[ "$1" == "windows" ]]; then
    printf ".exe"
  fi
}

build_host() {
  local bin_ext=""
  if [[ "${OS:-}" == "Windows_NT" ]]; then
    bin_ext=".exe"
  fi

  echo "Building ${binary_name}${bin_ext} for production..."
  mkdir -p "${build_dir}"
  go build -ldflags "${ldflags}" -o "${build_dir}/${binary_name}${bin_ext}" "${main_path}"
  echo "Build complete: ${build_dir}/${binary_name}${bin_ext}"
}

build_target() {
  local raw_target="$1"
  local normalized="${raw_target//-//}"
  local target_os="${normalized%%/*}"
  local target_arch="${normalized##*/}"

  if [[ "${target_os}" == "${target_arch}" ]]; then
    echo "Invalid target: ${raw_target}" >&2
    usage >&2
    exit 2
  fi

  local target_ext
  target_ext="$(target_ext "${target_os}")"

  echo "Building for ${target_os}/${target_arch}..."
  mkdir -p "${build_dir}"
  GOOS="${target_os}" GOARCH="${target_arch}" go build -ldflags "${ldflags}" -o "${build_dir}/${binary_name}-${target_os}-${target_arch}${target_ext}" "${main_path}"
}

build_all() {
  local target
  for target in "${targets[@]}"; do
    build_target "${target}"
  done
  echo "All platforms built successfully!"
}

archive_release() {
  echo "Creating release archives..."
  (
    cd "${build_dir}"
    local artifact
    for artifact in "${binary_name}"-linux-* "${binary_name}"-darwin-*; do
      case "${artifact}" in
        *.tar.gz | *.zip) continue ;;
      esac
      if [[ -f "${artifact}" ]]; then
        tar -czf "${artifact}.tar.gz" "${artifact}"
        rm "${artifact}"
      fi
    done

    for artifact in "${binary_name}"-windows-*.exe; do
      if [[ -f "${artifact}" ]]; then
        zip -q "${artifact%.exe}.zip" "${artifact}"
        rm "${artifact}"
      fi
    done
  )
  echo "Release archives created in ${build_dir}/"
}

mode="host"
target=""

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    all | --all)
      mode="all"
      shift
      ;;
    release | --release)
      mode="release"
      shift
      ;;
    target | --target)
      if [[ "$#" -lt 2 ]]; then
        echo "Missing value for $1" >&2
        usage >&2
        exit 2
      fi
      mode="target"
      target="$2"
      shift 2
      ;;
    --target=*)
      mode="target"
      target="${1#--target=}"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown build option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "${mode}" in
  host)
    build_host
    ;;
  target)
    build_target "${target}"
    ;;
  all)
    build_all
    ;;
  release)
    build_all
    archive_release
    ;;
esac
