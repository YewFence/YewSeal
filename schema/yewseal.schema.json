{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "Config": {
            "type": "object",
            "description": "#Config 是 .yewseal.toml 的顶层结构。所有段落都可缺省。\n加密和 plan 选择阶段要求路径来自 files/groups,并要求最终授权集合非空。",
            "additionalProperties": false,
            "properties": {
                "encryption": {
                    "$ref": "#/$defs/EncryptionConfig"
                },
                "key": {
                    "$ref": "#/$defs/KeyConfig"
                },
                "recipients": {
                    "$ref": "#/$defs/RecipientConfig"
                },
                "sync": {
                    "$ref": "#/$defs/SyncConfig"
                }
            }
        },
        "EncryptionConfig": {
            "type": "object",
            "description": "#EncryptionConfig 定义加密文件映射。",
            "additionalProperties": false,
            "properties": {
                "files": {
                    "type": "array",
                    "description": "显式的明文/加密文件对。所有运行时处理的路径都必须来自这里或 groups。",
                    "items": {
                        "$ref": "#/$defs/FilePair"
                    }
                },
                "groups": {
                    "type": "array",
                    "description": "按 glob 模式批量匹配的加密文件组。",
                    "items": {
                        "$ref": "#/$defs/GroupConfig"
                    }
                }
            }
        },
        "FilePair": {
            "type": "object",
            "description": "#FilePair 定义一对明文/加密文件映射。",
            "additionalProperties": false,
            "properties": {
                "encrypted": {
                    "type": "string",
                    "description": "加密文件路径,用作 encrypt 的输出和 decrypt 的输入。"
                },
                "format": {
                    "description": "覆盖文件格式探测,用于扩展名不标准的文件(如 .dev.vars)。",
                    "$ref": "#/$defs/Format"
                },
                "plaintext": {
                    "type": "string",
                    "description": "明文文件路径,用作 encrypt 的输入和 decrypt 的输出。"
                },
                "recipients": {
                    "type": "array",
                    "description": "授权 alias 集合。省略时继承 group 或顶层 defaults。",
                    "items": {
                        "type": "string"
                    },
                    "prefixItems": [
                        {
                            "type": "string"
                        }
                    ],
                    "minItems": 1
                }
            },
            "required": [
                "encrypted",
                "plaintext"
            ]
        },
        "Format": {
            "description": "#Format 是 YewSeal 支持的加密文件格式。\n规范名之外还接受运行时别名(yml→yaml、dotenv→env、bin→binary),\n与 internal/seal.FormatSpellings 保持一致(有 Go 测试强制);运行时归一化为规范名。",
            "enum": [
                "toml",
                "yaml",
                "yml",
                "json",
                "env",
                "dotenv",
                "ini",
                "binary",
                "bin"
            ]
        },
        "GroupConfig": {
            "type": "object",
            "description": "#GroupConfig 定义一组按模式匹配的加密文件。",
            "additionalProperties": false,
            "properties": {
                "format_rules": {
                    "type": "array",
                    "description": "格式覆盖规则,语法为 \"<glob>=<format>\",如 \"*.dev.vars=env\"。\nformat 仅接受小写(Go 运行时对大小写宽容,schema 引导规范写法),\n与 #Format 一样接受 yml/dotenv/bin 别名。",
                    "items": {
                        "type": "string",
                        "pattern": "^.+=(toml|yaml|yml|json|env|dotenv|ini|binary|bin)$"
                    }
                },
                "patterns": {
                    "type": "array",
                    "description": "glob 模式列表,如 \"config/**/*.toml\"。缺省时使用默认扫描模式:\n加密扫描常见配置扩展名并排除 *.enc.*,解密扫描 *.enc.* 文件。",
                    "items": {
                        "type": "string"
                    }
                },
                "recipients": {
                    "type": "array",
                    "description": "扫描结果的授权 alias 集合。省略时继承顶层 defaults。",
                    "items": {
                        "type": "string"
                    },
                    "prefixItems": [
                        {
                            "type": "string"
                        }
                    ],
                    "minItems": 1
                },
                "unknown_as_binary": {
                    "type": "boolean",
                    "description": "无法探测格式的文件按 binary 处理。"
                }
            }
        },
        "KeyConfig": {
            "type": "object",
            "description": "#KeyConfig 定义 Age 密钥位置。切勿把私钥内容写进配置文件。",
            "additionalProperties": false,
            "properties": {
                "file_path": {
                    "type": "string",
                    "description": "Age 私钥文件路径。"
                }
            }
        },
        "RecipientConfig": {
            "type": "object",
            "description": "#RecipientConfig 定义公开 recipient 授权策略。\nregistry 只包含公开 Age recipient,不包含私钥。",
            "additionalProperties": false,
            "properties": {
                "defaults": {
                    "type": "array",
                    "description": "默认 alias 集合。缺省时每个 file/group 都必须显式声明 recipients。",
                    "items": {
                        "type": "string"
                    },
                    "prefixItems": [
                        {
                            "type": "string"
                        }
                    ],
                    "minItems": 1
                },
                "registry": {
                    "type": "object",
                    "description": "alias 到 Age recipient 公钥的映射。",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
        },
        "SyncConfig": {
            "type": "object",
            "description": "#SyncConfig 定义 Age 密钥同步设置。",
            "additionalProperties": false,
            "properties": {
                "environment": {
                    "type": "string",
                    "description": "Provider 侧的环境名称。"
                },
                "path": {
                    "type": "string",
                    "description": "Provider 侧的远程路径/目录。"
                },
                "project_id": {
                    "type": "string",
                    "description": "Provider 侧的项目标识符,sync 命令使用。"
                },
                "provider": {
                    "description": "密钥管理 Provider 名称。当前仅支持 infisical,\n新增 Provider 时需同步扩展此枚举。",
                    "const": "infisical"
                },
                "secret_name": {
                    "type": "string",
                    "description": "Age 私钥文件在 Provider 侧的 secret 名称。"
                }
            }
        }
    },
    "type": "object",
    "description": "Package schema 是 .yewseal.toml 的权威 schema,与 internal/config 的 Go struct 保持同步。\n\n三向锚定防漂移:\n  - mise run schema:check 用 cue vet 校验 example.yewseal.toml 符合本 schema\n  - internal/config 的 Go 测试 strict-unmarshal 同一 example(Go 不认识的字段会报错)\n  - 反射 tripwire 测试将 Go struct 与导出的 JSON Schema 逐字段结构对齐\n    (父级、类型、必填性),schema:check 的 diff 保证导出与本文件一致",
    "$ref": "#/$defs/Config"
}
